# Quick start:
# 1) cp .env.example .env
# 2) Edit variables marked [REQUIRED]
# 3) Keep values without quotes (dotenv format)

# ----------------------------
# [REQUIRED] Update these first
# ----------------------------
MONGODB_URI=YOUR_MONGODB_URI
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_AT_LEAST_32_CHARS

# ----------------------------
# [OPTIONAL] App runtime
# ----------------------------
NODE_ENV=development
PORT=3001
# Leave empty to auto-use request host/port (safer when changing PORT locally)
APP_BASE_URL=
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true
STATIC_DIR=public
MORGAN_FORMAT=dev
APP_TIMEZONE=Asia/Bangkok

# ----------------------------
# [OPTIONAL] Token + Cookie
# ----------------------------
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_EXPIRES_DAYS=7
COOKIE_HTTP_ONLY=true
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
COOKIE_PATH=/

# ----------------------------
# [OPTIONAL] Security + Upload
# ----------------------------
BCRYPT_SALT_ROUNDS=10
UPLOAD_PUBLIC_PATH=/images
UPLOAD_DIR=public/images
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp
UPLOAD_MAX_SIZE=5242880
UPLOAD_MAX_FILES=5

# ----------------------------
# [OPTIONAL] Database retry
# ----------------------------
DB_RETRY_ATTEMPTS=3
DB_RETRY_DELAY_MS=1000
